+    ) -> ModelReply:
+        if messages[-1].role == "tool":
+            return ModelReply(
+                message=Message(
+                    role="assistant", content=f"[离线读文件演示] 工具结果：{messages[-1].content}"
+                )
+            )
+        return ModelReply(
+            message=Message(
+                role="assistant",
+                tool_calls=(
+                    ToolCall(
+                        id=f"read_{uuid4().hex}",
+                        name="read_file",
+                        arguments=json.dumps({"path": self.path}, ensure_ascii=False),
